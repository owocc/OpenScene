# Browser-exposed runtime configuration (Vite embeds only VITE_* values).
VITE_OPENSCENE_ADMIN_URL=http://localhost:3000
VITE_OPENSCENE_APP_KEY=

# Build-process-only manifest publishing configuration.
# These values are read by the Vite plugin and sent as an HTTP header/body request;
# they must never use a VITE_ prefix.
OPENSCENE_ADMIN_URL=
OPENSCENE_APP_ID=
OPENSCENE_APP_KEY=
