# Public page JSON directory (S3/CloudFront). The browser only needs this value.
VITE_OPENSCENE_BASE_URL=https://cdn.example.com/openscene/apps/app-id/pages

# Build-process-only component manifest publishing configuration.
# These values must never use a VITE_ prefix.
OPENSCENE_ADMIN_URL=
OPENSCENE_APP_ID=
OPENSCENE_PUBLISH_KEY=
