{
  "name": "@openscene-ai/solid-v2",
  "version": "0.0.0",
  "private": true,
  "description": "SolidJS v2 adapter implementation for OpenScene.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "node": "./dist/server.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    }
  },
  "scripts": {
    "build": "vp pack --from-vite",
    "dev": "vp pack --from-vite --watch",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@openscene-ai/javascript": "workspace:*",
    "@openscene-ai/schema": "workspace:*",
    "@openscene-ai/core": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/web": "^2.0.0-rc.0",
    "@types/node": "catalog:",
    "solid-js": "^2.0.0-rc.2",
    "typescript": "catalog:",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "catalog:",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.0 <3",
    "solid-js": ">=2.0.0-rc.0 <3",
    "zod": "^4.0.0"
  }
}
