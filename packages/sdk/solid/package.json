{
  "name": "@openscene-ai/solid",
  "version": "0.0.0",
  "description": "Solid adapter for OpenScene and json-render.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "node": "./dist/server.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --from-vite",
    "dev": "vp pack --from-vite --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@json-render/core": "^0.20.0",
    "@json-render/solid": "^0.20.0",
    "@openscene-ai/constants": "workspace:*",
    "@openscene-ai/javascript": "workspace:*",
    "@openscene-ai/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "solid-js": "^1.9.14",
    "typescript": "catalog:",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "catalog:",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "zod": "^4.0.0"
  }
}
