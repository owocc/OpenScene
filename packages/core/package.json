{
  "name": "@openscene-ai/core",
  "version": "0.0.1-alpha.0",
  "description": "Core OpenScene constants, document schemas, and Studio bridge protocol.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
