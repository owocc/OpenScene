  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "test": "vp test",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@json-render/core": "^0.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
