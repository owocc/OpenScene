{
  "name": "openscene",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/**",
    "apps/*",
    "tools/*",
    "playground/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run studio#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "bumpp": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "bumpp": "^11.1.0"
  }
}
