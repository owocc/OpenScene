---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

const pathname = Astro.url.pathname;
const isChinese = pathname === "/zh-cn" || pathname.startsWith("/zh-cn/");
const target = isChinese
  ? pathname.replace(/^\/zh-cn(?=\/|$)/, "/en")
  : pathname.replace(/^\/en(?=\/|$)/, "/zh-cn");
const label = isChinese ? "English" : "中文";
---

<a
  href={target}
  class="inline-flex h-8 items-center gap-1.5 rounded-md border border-border bg-background px-2.5 text-xs font-semibold text-foreground no-underline shadow-xs transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
  aria-label={isChinese ? "Switch documentation language to English" : "切换文档语言为中文"}
>
  <Icon name="ph:translate" class="size-4" />
  <span>{label}</span>
</a>
